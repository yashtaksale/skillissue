# ===== Environment =====
ENV=local

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://skillissue:skillissue@localhost:5432/skillissue
DATABASE_URL_SYNC=postgresql://skillissue:skillissue@localhost:5432/skillissue

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== GitHub (public-read token for higher rate limits) =====
GITHUB_TOKEN=

# ===== LLM =====
ANTHROPIC_API_KEY=
LLM_MODE=fake
LLM_TRIAGE_MODEL=claude-sonnet-4
LLM_FIX_MODEL=claude-opus-4

# ===== Pipeline =====
PIPELINE_VERSION=0.1.0
SCANNER_IMAGE=skillissue/scanner:0.1.0

# ===== Limits =====
ANON_RATE_LIMIT_HOURLY=3
ANON_RATE_LIMIT_DAILY=10
PER_REPO_COOLDOWN_SECONDS=600
QUEUE_DEPTH_CAP=50
GLOBAL_DAILY_BUDGET_USD=5.00
SCAN_WALL_CLOCK_SECONDS=600
LLM_INPUT_TOKEN_CAP=150000
LLM_OUTPUT_TOKEN_CAP=30000
LLM_COST_HARD_CAP_USD=0.40

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Observability =====
SENTRY_DSN=
LOG_LEVEL=info
