# EditorConfig — https://editorconfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{py,yml,yaml,md,toml,cfg,ini}]
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_style = space
indent_size = 2

[*.{html,css,json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.{png,jpg,gif,ico,svg,woff,woff2}]
insert_final_newline = false
